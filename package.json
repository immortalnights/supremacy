{
    "name": "supremacy",
    "private": true,
    "version": "0.5.0",
    "type": "module",
    "workspaces": [
        ".",
        "tools/save-editor"
    ],
    "scripts": {
        "dev": "vite",
        "test": "vitest",
        "build": "tsc && vite build",
        "format": "prettier --write .",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "check": "tsc",
        "preview": "vite preview",
        "run:simulation": "node --experimental-strip-types --enable-source-maps ./simulator.ts",
        "build:simulation": "npx esbuild --format=esm --platform=node --bundle --tsconfig=./tsconfig.node.json --out-extension:.js=.js --outfile=./Supremacy.mjs --sourcemap  ./src/Supremacy/index.ts",
        "build:simulation:watch": "npx esbuild --format=esm --platform=node --bundle --tsconfig=./tsconfig.node.json --out-extension:.js=.js --outfile=./Supremacy.mjs --sourcemap --watch ./src/Supremacy/index.ts"
    },
    "dependencies": {
        "game-signaling-server": "github:immortalnights/game-signaling-server#v0.1.2",
        "jotai": "^2.17.0",
        "random": "^5.4.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.30.3",
        "webrtc-lobby": "github:immortalnights/webrtc-lobby-lib#v0.2.3"
    },
    "devDependencies": {
        "@swc-jotai/debug-label": "^0.1.1",
        "@swc-jotai/react-refresh": "^0.2.0",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "eslint": "^9.39.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^17.3.0",
        "happy-dom": "^20.4.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-tsconfig-paths": "^6.0.5",
        "vitest": "^4.0.18"
    },
    "imports": {
        "#Supremacy/*": "./src/Supremacy/*.ts"
    }
}
